{
  "name": "uchkoprik-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Uchko'prik 1-sonli texnikumi rasmiy web-portali (React + Express + Prisma + PostgreSQL)",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev -w server\" \"npm:dev -w client\"",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/restore.ts",
    "build": "npm run build -w client && npm run build -w server",
    "start": "node server/dist/server.js",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w server && npm run typecheck -w client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test -w server && npm run test -w client",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:unseed:demo": "tsx prisma/seed-demo.ts --unseed",
    "modules": "tsx scripts/modules.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.8",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7"
  }
}
