# ───── Uchko'prik 1-sonli texnikumi portali — environment namunasi ─────
# Bu faylni .env nomi bilan nusxalang va qiymatlarni o'zgartiring. .env Git'ga qo'shilmaydi.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL ulanish manzili. Dev: `npm run db:dev` shu portda bazani ishga tushiradi.
DATABASE_URL=postgresql://postgres:postgres@localhost:54320/uchkoprik?schema=public

# Saytning ommaviy manzili (canonical, sitemap.xml va hreflang uchun). Productionda https:// bo'lishi shart.
PUBLIC_URL=http://localhost:5173

# Brauzerdan API'ga ruxsat etilgan origin'lar (vergul bilan). Production'da odatda bitta domen.
CORS_ORIGINS=http://localhost:5173

# Sessiya
SESSION_TTL_HOURS=12
# Productionda true (Secure cookie). Dev'da http uchun false.
COOKIE_SECURE=false
# Production'da HTTP so'rovlarni HTTPS ga yo'naltirish (reverse proxy ortida TRUST_PROXY=1 qiling)
FORCE_HTTPS=false
TRUST_PROXY=0

# Login rate limit: oynada nechta urinish va oyna davomiyligi (daqiqa)
LOGIN_RATE_MAX=5
LOGIN_RATE_WINDOW_MINUTES=15
# Bitta IP uchun daqiqasiga umumiy API so'rovlari limiti
API_RATE_MAX=600

# Swagger (/api/v1/docs). Productionda standart holatda o'chiq; faqat kerak bo'lsa "true" qiling.
# ENABLE_API_DOCS=false
# Frontend build papkasi (standart: ./client/dist)
# CLIENT_DIST_DIR=./client/dist

# Fayl yuklash
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
# Video fayl yuklash chegarasi (MB). Reverse proxy'da ham (nginx: client_max_body_size) shuncha ruxsat bering
MAX_VIDEO_MB=300

# Rejalashtirilgan nashr: scheduler tekshiruv oralig'i (soniya)
SCHEDULER_INTERVAL_SECONDS=60

# Boshlang'ich administratorni yaratish uchun (faqat `npm run admin:create` ishlatadi).
# Parolni bu yerda saqlamang: skript uni terminalda so'raydi yoki bir martalik environment orqali oladi.
# ADMIN_EMAIL=admin@example.uz
# ADMIN_NAME=Administrator
# ADMIN_PASSWORD=
